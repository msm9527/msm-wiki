# syntax=docker/dockerfile:1.7
ARG MSM_DOCKER_CLI_IMAGE=docker:29.6.2-cli@sha256:be132a9f282288de4afaf63379dff75711fda0147c6b72a9df44e51841402144
FROM ${MSM_DOCKER_CLI_IMAGE} AS docker-cli

# 整理发布归档，最终镜像只复制一份主程序和随附声明。
FROM debian:13-slim AS release-payload
ARG TARGETPLATFORM
COPY binaries/${TARGETPLATFORM}/ /tmp/msm-release/
RUN set -eu; \
    install -m 0755 /tmp/msm-release/msm /usr/local/bin/msm; \
    mkdir -p /usr/share/doc/msm; \
    for notice in THIRD_PARTY_NOTICES.md OSS_PROVENANCE.md; do \
      if [ -f "/tmp/msm-release/$notice" ]; then \
        install -m 0644 "/tmp/msm-release/$notice" "/usr/share/doc/msm/$notice"; \
      fi; \
    done; \
    if [ -d /tmp/msm-release/licenses ]; then \
      cp -R /tmp/msm-release/licenses /usr/share/doc/msm/; \
    fi; \
    rm -rf /tmp/msm-release

# 基于 Debian 13 slim 镜像
FROM debian:13-slim

# 声明构建参数
ARG TARGETPLATFORM

# 安装运行时依赖并应用安全更新
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    iproute2 \
    iputils-ping \
    iptables \
    net-tools \
    nftables \
    openresolv \
    procps \
    tzdata \
    wireguard-go \
    wireguard-tools \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    for command in bash ip sysctl iptables nft wg wg-quick wireguard-go resolvconf; do \
      command -v "${command}" >/dev/null || exit 1; \
    done

# 创建必要的目录
RUN mkdir -p /opt/msm /var/log/msm

# 复制对应架构的二进制文件
# TARGETPLATFORM 格式: linux/amd64, linux/arm64, linux/arm/v7
COPY --from=release-payload /usr/local/bin/msm /usr/local/bin/msm
COPY --from=release-payload /usr/share/doc/msm/ /usr/share/doc/msm/
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
RUN docker --version && docker compose version

# 以 root 用户运行以支持透明代理、TUN 设备等高级网络功能
WORKDIR /opt/msm

# 暴露端口
# 7777: MSM Web 管理界面
# 53: DNS (MosDNS) - UDP 和 TCP
# 1053: DNS 备用端口
# 7890: HTTP 代理 (SingBox/Clash)
# 7891: SOCKS5 代理 (SingBox/Clash)
# 7892: 混合代理端口 (SingBox/Clash)
# 6666: 管理端口
EXPOSE 7777 53/tcp 53/udp 1053 7890 7891 7892 6666

# 环境变量
ENV JWT_SECRET="" \
    MSM_PORT="7777" \
    MSM_CONFIG_DIR="/opt/msm" \
    MSM_DOCKER="1" \
    TZ="Asia/Shanghai"

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${MSM_PORT}/ || exit 1

# 启动命令
CMD ["sh", "-c", "msm serve -p ${MSM_PORT} -c ${MSM_CONFIG_DIR}"]
